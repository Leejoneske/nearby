# The publishable key is meant to ship inside the app — row level security is
# what protects the data, not this string. Never put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Android Maps SDK key. Leave it unset and the app draws its own map instead
# of Google's — a worse map, not a broken one.
#
# Restrict the key to the package name app.nearby.directory and the signing
# certificate's SHA-1 fingerprint in the Google Cloud console. A key without
# those restrictions can be lifted out of the APK and used on somebody else's
# account. In CI it comes from the GOOGLE_MAPS_API_KEY repository secret.
GOOGLE_MAPS_API_KEY=
